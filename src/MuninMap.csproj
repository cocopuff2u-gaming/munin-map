<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>3.0.1</Version>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>MuninMap</AssemblyName>
    <AssemblyTitle>Munin Map</AssemblyTitle>
    <Copyright>(c) 2026 Cody Keats and contributors (see LICENSE)</Copyright>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NuGetAudit>false</NuGetAudit>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3"><PrivateAssets>all</PrivateAssets></PackageReference>
    <PackageReference Include="Krafs.Publicizer" Version="2.2.1"><PrivateAssets>all</PrivateAssets></PackageReference>
  </ItemGroup>
  <!-- the web app rides inside the DLL too, so the map still works when a mod manager or a
       hand install drops the web folder. Files on disk next to the DLL win when present. -->
  <ItemGroup>
    <EmbeddedResource Include="..\web\**\*" Exclude="..\web\**\.*" LogicalName="web/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- one DLL: the libraries that would be copied next to it (websocket-sharp, ImageSharp and the
       System DLLs it needs) are embedded as deps/<name>.dll instead and loaded by Util/Deps.cs.
       System.Memory and Unsafe are left out: the game has its own. -->
  <Target Name="EmbedDeps" AfterTargets="ResolveAssemblyReferences" BeforeTargets="CoreCompile">
    <ItemGroup>
      <EmbeddedResource Include="@(ReferenceCopyLocalPaths)" Condition="'%(Extension)' == '.dll' and '%(Filename)' != 'System.Memory' and '%(Filename)' != 'System.Runtime.CompilerServices.Unsafe'" LogicalName="deps/%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <Publicize Include="assembly_valheim" />
    <Publicize Include="assembly_utils" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony"><HintPath>..\libs\BepInEx\core\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>..\libs\BepInEx\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Harmony"><HintPath>..\libs\BepInEx\core\BepInEx.Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="assembly_valheim"><HintPath>..\libs\valheim\assembly_valheim.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="assembly_utils"><HintPath>..\libs\valheim\assembly_utils.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Mono.Security"><HintPath>..\libs\valheim\Mono.Security.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>..\libs\valheim\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>..\libs\valheim\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.JSONSerializeModule"><HintPath>..\libs\valheim\UnityEngine.JSONSerializeModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Splatform"><HintPath>..\libs\valheim\Splatform.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="steamworks"><HintPath>..\libs\valheim\com.rlabrecque.steamworks.net.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="WebsocketSharp"><HintPath>..\libs\websocket-sharp.dll</HintPath></Reference>
    <Reference Include="System.IO.Compression" />
    <!-- lossless WebP tiles (Apache-2.0); embedded in MuninMap.dll with its helper DLLs (EmbedDeps) -->
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.13" />
  </ItemGroup>
</Project>
